# Vite / bun build artifacts
node_modules
bun.lockb.bak

# TypeScript incremental-compilation cache (CodeRabbit #116). These
# are machine-specific build metadata, regenerated by `tsc -b` on
# every run — `dist/` is the publishable artifact, `.tsbuildinfo` is
# private to the local checkout.
*.tsbuildinfo

# The Vite-built SPA bundle is intentionally NOT ignored — rust-embed
# bakes dist/ into kanade-backend.exe at compile time, and we need it
# present on every cargo build / cargo publish. CI / `cargo make
# web-build` regenerates it before committing.

# Playwright component-test output. `playwright/index.html` + `index.tsx`
# are the mount host (tracked source); everything below is regenerated per
# run: `.cache/` is CT's Vite bundle of the components under test, and the
# result/report dirs are the run artifacts.
playwright/.cache/
test-results/
playwright-report/
blob-report/

# Screenshot baselines are per-platform. Only the CI platform's (`-linux`)
# are committed; a dev generating on win32/darwin must never commit those —
# they'd never match the Linux CI run. See playwright-ct.config.ts.
src/__screenshots__/*-win32.png
src/__screenshots__/*-darwin.png

# Editor / OS noise
.vscode/
.idea/
*.log
