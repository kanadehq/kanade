{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // Explicit, because TS no longer picks `@types/bun` up on its own here
    // and `*.test.ts` imports `bun:test`. Naming any package switches off
    // automatic `@types/*` inclusion, which is fine: everything else the SPA
    // uses (react, react-dom, node) is reached through an import, not an
    // ambient global.
    "types": ["bun"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  // `demo/` is type-checked too, even though it never enters the bundle
  // (`noEmit` is on and Vite builds from index.html). The demo mock is
  // real TypeScript that people edit; leaving it outside meant a mistake
  // there surfaced when the mock crashed at run time instead of in CI.
  "include": ["src", "demo"]
}
