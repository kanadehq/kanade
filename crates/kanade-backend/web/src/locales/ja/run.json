{
  "title": "1 台の PC でスクリプトを実行",
  "description": "<code>/api/run</code> に POST します。バックエンドが NATS 経由で転送し、エージェントの <code>ExecResult</code> を待ち受けます。<code>kanade run &lt;pc_id&gt; -- &lt;script&gt;</code> と同等です。",
  "fields": {
    "pcId": "pc_id",
    "shell": "shell",
    "runAs": "run_as",
    "timeout": "タイムアウト (秒)",
    "jobId": "job_id (任意)",
    "script": "スクリプト"
  },
  "placeholders": {
    "pcId": "pc-01",
    "jobId": "ad-hoc-…",
    "script": "echo hello from kanade web"
  },
  "submit": "POST /api/run",
  "confirm": {
    "title": "{{pcId}} で実行しますか？",
    "summary": "shell={{shell}}, run_as={{runAs}} でスクリプトを実行します。取り消せません。",
    "confirmLabel": "実行",
    "cancelLabel": "キャンセル"
  },
  "errorTitle": "実行に失敗しました",
  "result": {
    "exitCode": "exit_code:",
    "stdout": "stdout",
    "stderr": "stderr",
    "empty": "(空)"
  }
}
