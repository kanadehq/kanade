msgid ""
"```powershell\n"
"$AgentSourceUrl       = 'http://kanade-backend.example.com:8080'\n"
"$AgentSourceVersion   = '0.43.0'\n"
"$AgentSourceSha256    = '<lowercase hex of kanade-backend.exe>'\n"
