msgstr "`OBJECT_APP_PACKAGES` にアップロード。"

#: src\operations/agent-mediated-updates/index.md:30
msgid "`kanade script publish <name> <version> <file>`"
msgstr "`kanade script publish <name> <version> <file>`"

