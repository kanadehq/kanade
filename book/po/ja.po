msgstr "`$PSScriptRoot` に書ける"

#: src\developing/writing-agent-scripts.md:65
msgid "Has admin"
msgstr "admin 権限あり"

#: src\developing/writing-agent-scripts.md:67
msgid "`system` (default)"
msgstr "`system` (デフォルト)"

#: src\developing/writing-agent-scripts.md:67
msgid "LocalSystem"
msgstr "LocalSystem"

#: src\developing/writing-agent-scripts.md:67
#: src\developing/writing-agent-scripts.md:68
#: src\developing/writing-agent-scripts.md:69
msgid "✓"
msgstr "✓"

#: src\developing/writing-agent-scripts.md:67
#: src\developing/writing-agent-scripts.md:69
